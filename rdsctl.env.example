# rdsctl 运行配置
# 复制为仓库根目录 rdsctl.env 即生效(./scripts/deploy.sh 首次会自动生成);
# 也可直接 export 同名环境变量(优先级: 环境变量 > rdsctl.env > 默认值)。

# ── HTTP 服务 ──
RDSCTL_PORT=9113
RDSCTL_USER=admin
RDSCTL_PASS=admin

# ── MySQL 控制面持久化(任务/节点/审计/实例记录) ──
RDSCTL_MYSQL_HOST=127.0.0.1
RDSCTL_MYSQL_PORT=3306
RDSCTL_MYSQL_USER=root
# 留空 = root 免密(本项目捆绑实例默认);如外部 MySQL 有密码请填入
RDSCTL_MYSQL_PASS=
RDSCTL_MYSQL_DB=rdsctl

# ── 可选 ──
# 捆绑 MySQL 数据目录(mysql.sh 管理;默认仓库内 .rdsctl-mysql)
# RDSCTL_MYSQL_DATA_DIR=$HOME/.rdsctl-mysql
# 巡检周期(秒),验收可调小
RDSCTL_SWEEP_SECS=30
# mysql 客户端真实路径(验收垫片环境下必须显式指定,避免被 PATH 内假 mysql 劫持)
# RDSCTL_MYSQL_CLI=/usr/local/bin/mysql

# ── M0(大规模演进,见 docs/scaling-design.md) ──
# 控制面归属:新建实例写入的 region/az/shard/tenant(占位)
RDSCTL_REGION=default
RDSCTL_AZ=default
RDSCTL_SHARD=default
RDSCTL_TENANT=
# 控制端标识(实例 lease holder;多进程/多副本需唯一,默认 hostname:pid)
# RDSCTL_CONTROLLER_ID=node-1
# 实例操作锁 lease 秒(默认 30;watch_task 轮询续约)
# RDSCTL_LOCK_LEASE=30
# 启动恢复:1=续跑(未终态任务重新执行,已完成节点不重跑);默认 0=中断标 failed
# RDSCTL_RESUME_TASKS=0
# ── 镜像源(默认 docker hub;离线/受限网络按需指向国内加速或内网 registry) ──
# 例(daocloud 加速):
# RDSCTL_MYSQL_IMAGE=docker.m.daocloud.io/library/mysql:8.0
# RDSCTL_PROXY_IMAGE=registry.internal.example.com/perf-2shard-newproxy:latest
# DTS(canal) 默认 canal/canal-server:v1.1.7(docker hub,外网受限时必配国内源):
RDSCTL_DTS_IMAGE=docker.m.daocloud.io/canal/canal-server:v1.1.7
# xenon(raft 高可用架构)节点镜像:默认 xenon-local:latest,
# 需先在 xenon 项目下执行 deploy/xenon.sh build 构建产物(MySQL8 + xenon 同容器);
# 外网受限时可指向内网 registry(如 registry.internal.example.com/xenon-local:latest)
# RDSCTL_XENON_IMAGE=xenon-local:latest
# 存储后端:默认 mysql;memory=进程内(无 MySQL 的 lab/合成)
# RDSCTL_STORE_BACKEND=memory

# ── AI 提能规则版(docs/dba-ai-design.md §4/§6/§8;全部默认保守/关闭,零配置零行为变化)──
# 慢查治理:总耗时/均值/次数阈值 + 上升异常(GROW_PCT 环比涨幅 %,0=关闭上升规则)
RDSCTL_SLOW_AVG_MS=1000
RDSCTL_SLOW_MAX_MS=5000
RDSCTL_SLOW_MIN_COUNT=10
RDSCTL_SLOW_GROW_PCT=200
# 容量采样周期(秒;0=关闭采样,默认关闭;开启建议 300)
RDSCTL_CAP_SECS=0
# 容量采样保留(天)与预警阈值(到达 90% 的天数、shard 水位上限)
RDSCTL_CAP_RETENTION_DAYS=90
RDSCTL_CAP_WARN_DAYS=14
RDSCTL_CAP_SHARD_LIMIT=10000
# 自动报告:1=启用每日(UTC HHMM,默认 0005)+ 周一加产周报
RDSCTL_REPORT_ENABLED=0
RDSCTL_REPORT_HHMM=0005
# 报告并表开关(容量/慢查/alerts;insights 异常群默认含)
RDSCTL_REPORT_INCLUDE_CAP=1
RDSCTL_REPORT_INCLUDE_SLOW=1
RDSCTL_REPORT_INCLUDE_ALERTS=1
